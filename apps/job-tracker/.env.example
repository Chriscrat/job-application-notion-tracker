# Create .env.local from this file and keep your real token private.
NOTION_TOKEN=secret_your_notion_integration_token
# In Notion: database settings → Manage data sources → Copy data source ID.
NOTION_APPLICATIONS_DATA_SOURCE_ID=your_notion_data_source_id
NOTION_PROFILE_PAGE_ID=your_notion_data_source_id
NOTION_SKILLS_DATA_SOURCE_ID=your_notion_data_source_id
NOTION_EXPERIENCE_PAGE_ID=your_notion_data_source_id

# Personal app login. Keep these values private.
APP_USERNAME=your_personal_username
APP_PASSWORD=choose_a_long_unique_password

# Generate a random value of at least 32 characters, for example: openssl rand -base64 48
APP_SESSION_SECRET=replace_with_a_long_random_secret

# Your Anthropic API key to generate on plateform.claude.com on API keys section
ANTHROPIC_API_KEY=you_api_key

# Anthropic model used to analyze a job offer and the profil retrieve from Notion
ANTHROPIC_MODEL=model_name
