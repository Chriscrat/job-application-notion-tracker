{
    "name": "@chriscrat/chatbot",
    "version": "0.1.0",
    "description": "Composant chatbot AI réutilisable avec support de commandes contextuelles",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles": "./dist/style.css"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly --declaration",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vanilla-extract/css": "^1.16.2",
        "@vanilla-extract/vite-plugin": "^4.0.19",
        "@vitejs/plugin-react": "^6.0.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0"
    },
    "keywords": [
        "chatbot",
        "ai",
        "react",
        "component",
        "conversational-ui"
    ],
    "author": "Chriscrat",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/chriscrat/notion-job-tracker.git",
        "directory": "packages/chatbot"
    },
    "dependencies": {
        "@lottiefiles/dotlottie-react": "^0.19.13",
        "dompurify": "^3.4.13",
        "lottie-react": "^2.4.1",
        "marked": "^18.0.0"
    }
}
